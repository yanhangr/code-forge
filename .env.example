# Copy this file to .env and fill in the real key.
# Do not commit .env; it is ignored by .gitignore.
DEEPSEEK_API_KEY=sk-replace-me
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Set to 0 only when a local proxy rewrites the TLS certificate chain.
# Do not use this in production.
DEEPSEEK_VERIFY_SSL=0

# Optional Impala tools: config path is relative to FORGE_RUNTIME_DIR (.runtime).
# Copy config/examples/impala.single-department.json to .runtime/config/impala.json.
# Fill host/user/CA settings there; credentials stay in this ignored .env or service environment.
# FORGE_IMPALA_CONFIG=config/impala.json
# FORGE_IMPALA_A_PASSWORD=replace-me
